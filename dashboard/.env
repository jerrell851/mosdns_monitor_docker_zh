# ============================================================
# mosdns 监控栈统一配置文件
# docker-compose 自动读取此文件, mosdns-log.sh 也 source 它
# 修改后重启: docker compose up -d
# ============================================================

# --- 网络 ---
DOCKER_HOST_IP=192.168.11.200
ROUTER_IP=192.168.11.1

# --- 端口 ---
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
LOKI_PORT=3100
VECTOR_LOG_PORT=9010
MOSDNS_API_PORT=8338
MOSDNS_DNS_PORT=5335

# --- Grafana 数据源 UID (需与 panel.json 一致) ---
LOKI_DATASOURCE_UID=P8E80F9AEF21F6940
PROMETHEUS_DATASOURCE_UID=ffkn40vmjsdtsf

# --- Prometheus scrape 目标 ---
PROMETHEUS_TARGET=192.168.11.1:8338
