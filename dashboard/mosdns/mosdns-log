#!/bin/sh /etc/rc.common
# ============================================================
# mosdns 日志转发 (procd 管理)
#
#   start    启动日志转发
#   stop     停止日志转发
#   restart  重启日志转发
#
# mosdns 管理请用 mosdns-cli
# ============================================================

USE_PROCD=1
START=90
STOP=10

DOCKER_HOST="192.168.11.200"
DOCKER_PORT="9010"
LOG_FILE="/var/log/mosdns.log"

cleanup() {
    ps | grep -E "/var/log/mosdns\.log|socat.*${DOCKER_PORT}" | grep -v grep | \
        awk '{print $1}' | xargs -r kill 2>/dev/null
    sleep 1
}

start_service() {
    # 已在运行则跳过
    ps | grep -qE "/var/log/mosdns\.log" && exit 0
    cleanup
    procd_open_instance
    procd_set_param command /bin/sh -c "
        while [ ! -f ${LOG_FILE} ]; do sleep 5; done
        tail -n 0 -F ${LOG_FILE} | while IFS= read -r line; do
            echo \"\$line\" | socat -u - UDP:${DOCKER_HOST}:${DOCKER_PORT}
        done
    "
    procd_set_param respawn 300 5 10
    procd_close_instance
}

stop_service() { cleanup; }
