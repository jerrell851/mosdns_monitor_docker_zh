# ============================================================================
# mosdns DNS 分流配置
# 二创设计：Jerrell
# 部署位置: 重命名为 config_custom.yaml 后部署到 /etc/mosdns/
# 注意: 此为脱敏示例，部署前需修改 forward_local DNS 和 black_hole IP
# 监听端口: 0.0.0.0:5335 (UDP+TCP)
# API 端点: 0.0.0.0:8338 (Prometheus metrics + REST)
#
# 分流逻辑 (main_sequence 执行顺序):
#   拒绝类 → 广告拦截 → hosts 本地 → redirect 重定向 → 缓存查找
#   → Apple 国内优选 → DDNS 强制本地 → 白名单本地 → 流媒体专用线路
#   → 灰名单远程 → 国外域名远程 → 国内域名本地 → 兜底 Google/Cloudflare 竞速
#
# 拒绝最先执行：已知恶意/无用域名直接杀掉，避免浪费后续步骤的计算资源。
#
# 每条路由都包装了 query_summary 上报到 Grafana 面板。
# ============================================================================

log:
  level: info
  file: "/var/log/mosdns.log"

api:
  http: "0.0.0.0:8338"

include: []

plugins:
  # =========================================================================
  # 域名/IP 分类规则集 (domain_set / ip_set)
  # 数据来源: v2ray-rules-dat 生成的 geosite/geoip 文本文件 + 自定义规则
  # =========================================================================

  # 国内域名 — 走本地 DNS
  - tag: geosite_cn
    type: domain_set
    args:
      files: ["/var/mosdns/geosite_cn.txt"]

  # 国内 IP — 用于 Apple 域名返回结果校验
  - tag: geoip_cn
    type: ip_set
    args:
      files: ["/var/mosdns/geoip_cn.txt"]

  # Apple 域名 — 先走本地 DNS 查国内 CDN，非国内 IP 则回退 114 DNS
  - tag: geosite_apple
    type: domain_set
    args:
      files: ["/var/mosdns/geosite_apple.txt"]

  # 非国内域名 — 直接走 Google/Cloudflare 远程 DNS
  - tag: geosite_no_cn
    type: domain_set
    args:
      files: ["/var/mosdns/geosite_geolocation-!cn.txt"]

  # 自定义白名单 — 强制走本地 DNS（如公司内网域名）
  - tag: whitelist
    type: domain_set
    args:
      files: ["/etc/mosdns/rule/whitelist.txt"]

  # 自定义黑名单 — 直接拒绝解析
  - tag: blocklist
    type: domain_set
    args:
      files: ["/etc/mosdns/rule/blocklist.txt"]

  # 灰名单 — 强制走远程 DNS（疑似被污染的域名）
  - tag: greylist
    type: domain_set
    args:
      files: ["/etc/mosdns/rule/greylist.txt"]

  # DDNS 动态域名 — 强制本地 DNS + TTL 设为 5 秒以保证 IP 实时性
  - tag: ddnslist
    type: domain_set
    args:
      files: ["/etc/mosdns/rule/ddnslist.txt"]

  # 本地 hosts 静态解析 — 优先级最高（仅次于 hosts_seq 在 main_sequence 的位置）
  - tag: hosts
    type: hosts
    args:
      files: ["/etc/mosdns/rule/hosts.txt"]

  # redirect — 将指定域名重定向到特定 IP（类似 hosts 但支持通配符）
  - tag: redirect
    type: redirect
    args:
      files: ["/etc/mosdns/rule/redirect.txt"]

  # 广告域名 — 默认注释，按需启用
  - tag: adlist
    type: domain_set
    args:
      files: ["/var/mosdns/geosite_category-ads-all.txt"]

  # 流媒体域名 (Netflix/Disney+/Hulu + 自定义) — 走专用远程 DNS 避免被屏蔽
  - tag: stream_media
    type: domain_set
    args:
      files:
        - "/var/mosdns/geosite_disney.txt"
        - "/var/mosdns/geosite_netflix.txt"
        - "/var/mosdns/geosite_hulu.txt"
        - "/etc/mosdns/rule/streaming.txt"

  # Cloudflare IP 段 — 用于 has_resp_sequence 中将 Cloudflare IP 替换为自定义地址
  - tag: cloudflare_cidr
    type: ip_set
    args:
      files: ["/etc/mosdns/rule/cloudflare-cidr.txt"]

  # =========================================================================
  # DNS 缓存
  # =========================================================================

  # lazy_cache: 查缓存 → 命中则直接返回
  #             未命中则继续路由，拿到响应后存入缓存
  # ttl 300-86400: 最小 5 分钟、最大 24 小时
  #   - 300s 防止上游超短 TTL 导致频繁回源
  #   - 86400s 符合 BIND/Unbound 行业惯例
  # lazy_cache_ttl 86400: 过期条目再保留 24h，期间有查询则返回旧值并后台刷新
  - tag: lazy_cache
    type: cache
    args:
      size: 8000
      lazy_cache_ttl: 86400

  # =========================================================================
  # DNS 上游服务器 (forward 插件)
  #
  # 命名规则:
  #   forward_xxx        — 原始转发器
  #   forward_xxx_upstream — 包装 prefer_ipv4 的序列
  #   forward_xxx_seq    — 包装 query_summary 日志的序列（供 main_sequence 用）
  # =========================================================================

  # 114 公共 DNS (UDP) — Apple 域名国内查询的备用线路
  - tag: forward_xinfeng_udp
    type: forward
    args:
      concurrent: 2
      upstreams:
        - addr: "114.114.114.114"
        - addr: "114.114.115.115"

  # 国内 DNS 池 — 用于国内域名、白名单、DDNS
  - tag: forward_local
    type: forward
    args:
      concurrent: 2
      upstreams:
        - addr: "223.5.5.5"       # 替换为你的运营商 DNS 以获得最快 CDN
        - addr: "119.29.29.29"

  # 国外 DNS 双上游 (Google + Cloudflare) — 非国内域名、灰名单使用
  - tag: forward_remote
    type: forward
    args:
      concurrent: 2
      upstreams:
        - addr: "https://8.8.8.8/dns-query"
          bootstrap: "223.5.5.5"
          enable_pipeline: false
          insecure_skip_verify: false
          idle_timeout: 30
        - addr: "https://1.1.1.1/dns-query"
          bootstrap: "223.5.5.5"
          enable_pipeline: false
          insecure_skip_verify: false
          idle_timeout: 30

  - tag: forward_remote_upstream
    type: sequence
    args:
      - exec: prefer_ipv4
      - exec: $forward_remote

  # Google DNS only — fallback 主查询
  # 与 forward_remote 的 8.8.8.8 参数一致，但单独拆分以便独立用作 primary
  - tag: forward_google
    type: forward
    args:
      concurrent: 1
      upstreams:
        - addr: "https://8.8.8.8/dns-query"
          bootstrap: "223.5.5.5"
          enable_pipeline: false
          insecure_skip_verify: false
          idle_timeout: 30

  # Cloudflare DNS only — fallback 备查询
  - tag: forward_cloudflare
    type: forward
    args:
      concurrent: 1
      upstreams:
        - addr: "https://1.1.1.1/dns-query"
          bootstrap: "223.5.5.5"
          enable_pipeline: false
          insecure_skip_verify: false
          idle_timeout: 30

  # 流媒体专用 DNS (仅 8.8.8.8) — 避免 1.1.1.1 返回被屏蔽 IP
  - tag: forward_stream_media
    type: forward
    args:
      concurrent: 2
      upstreams:
        - addr: "https://8.8.8.8/dns-query"
          bootstrap: "223.5.5.5"
          enable_pipeline: false
          insecure_skip_verify: false
          idle_timeout: 30

  - tag: forward_stream_media_upstream
    type: sequence
    args:
      - exec: prefer_ipv4
      - exec: $forward_stream_media

  - tag: forward_google_upstream
    type: sequence
    args:
      - exec: prefer_ipv4
      - exec: $forward_google

  - tag: forward_cloudflare_upstream
    type: sequence
    args:
      - exec: prefer_ipv4
      - exec: $forward_cloudflare

  # Apple 备用 114 DNS — 包装 query_summary 供面板展示
  - tag: forward_xinfeng_udp_seq
    type: sequence
    args:
      - exec: query_summary apple_fallback
      - exec: $forward_xinfeng_udp

  # =========================================================================
  # TTL 修改 — 在 has_resp_sequence 中调用
  # =========================================================================

  # 通用 TTL: 最小 5 分钟，最大 24 小时
  # 设 0-0 会导致 cache 插件无法缓存（TTL=0 的记录被跳过）
  - tag: modify_ttl
    type: sequence
    args:
      - exec: ttl 300-86400

  # DDNS 动态域名 TTL: 固定 5 秒
  # 保证 IP 变化后最迟 5 秒就能解析到新地址
  - tag: modify_ddns_ttl
    type: sequence
    args:
      - exec: ttl 5-5

  # =========================================================================
  # 日志包装序列 — 在每个转发/拒绝动作前插入 query_summary 调用
  # 产生的日志经 vector → loki → Grafana 面板展示
  # 这些序列不修改 DNS 响应，仅用于可观测性
  # =========================================================================

  - tag: forward_local_seq
    type: sequence
    args:
      - exec: query_summary forward_local
      - exec: $forward_local

  - tag: forward_remote_seq
    type: sequence
    args:
      - exec: query_summary forward_remote
      - exec: $forward_remote_upstream

  - tag: forward_stream_media_seq
    type: sequence
    args:
      - exec: query_summary forward_stream_media
      - exec: $forward_stream_media_upstream

  - tag: hosts_seq
    type: sequence
    args:
      - exec: $hosts
      - matches: has_resp
        exec: query_summary hosts

  - tag: redirect_seq
    type: sequence
    args:
      - exec: $redirect
      - matches: has_resp
        exec: query_summary redirect

  - tag: reject_blocklist
    type: sequence
    args:
      - exec: query_summary reject_blocklist
      - exec: reject 3

  # 广告域名拦截 — 默认注释，取消 main_sequence 中的注释即可启用
  - tag: reject_adlist
    type: sequence
    args:
      - exec: query_summary reject_blocklist
      - exec: reject 3

  - tag: reject_ptr
    type: sequence
    args:
      - exec: query_summary reject_ptr
      - exec: reject 3

  # HTTPS 类型 (qtype 65) 直接拒绝 — 减少不必要的加密 SVCB/HTTPS 记录查询
  - tag: reject_https
    type: sequence
    args:
      - exec: query_summary reject_https
      - exec: reject 3

  # Cloudflare 优选 IP 替换 — 包装 query_summary 供面板展示
  - tag: cloudflare_accel
    type: sequence
    args:
      - exec: query_summary cloudflare_accel
      - exec: black_hole 1.1.1.1 2.2.2.2    # 替换为 https://github.com/XIU2/CloudflareSpeedTest 测出的最快 IP

  # =========================================================================
  # 响应后处理 — main_sequence 中通过 jump 跳转到这里
  #
  # 流程:
  #   1. DDNS 域名 → TTL 固定 5s
  #   2. 非 DDNS 域名 → TTL 限制 300-86400s
  #   3. 非白名单/灰名单/流媒体 且 返回了 Cloudflare IP → 替换为自定义 IP
  #      (避免 Cloudflare 代理 IP 被错误使用)
  #   4. 有响应 → accept 返回给客户端
  # =========================================================================

  - tag: has_resp_sequence
    type: sequence
    args:
      - matches: qname $ddnslist
        exec: $modify_ddns_ttl
      - matches: "!qname $ddnslist"
        exec: $modify_ttl
      - matches:
          - "!qname $whitelist"
          - "!qname $greylist"
          - "!qname $stream_media"
          - resp_ip $cloudflare_cidr
        exec: $cloudflare_accel
      - matches: has_resp
        exec: accept

  # =========================================================================
  # Apple 域名特殊处理
  #
  # query_is_apple_domain:
  #   匹配 geosite_apple → 调用 apple_domain_fallback
  # apple_domain_fallback:
  #   primary: 用本地 DNS 查询 → 检查响应 IP 是否国内 → 非国内则 drop
  #   secondary: 114 DNS 直接返回（国内 DNS 不可靠时的备用）
  #   always_standby: true → primary 响应超 100ms 时并行发 secondary
  # =========================================================================

  - tag: query_is_non_local_ip
    type: sequence
    args:
      - exec: $forward_local_seq
      - matches: "!resp_ip $geoip_cn"
        exec: drop_resp

  - tag: apple_domain_fallback
    type: fallback
    args:
      primary: query_is_non_local_ip
      secondary: forward_xinfeng_udp_seq
      threshold: 100
      always_standby: true

  # =========================================================================
  # 最终兜底 — main_sequence 最后一步
  #
  # 前面所有规则都没匹配时走到这里
  # primary: Google DNS (8.8.8.8)
  # secondary: Cloudflare DNS (1.1.1.1)
  # always_standby: true → 主备并行竞速，谁快用谁
  # threshold: 500ms → primary 超过 500ms 则采纳 secondary 结果
  #
  # 拆分主备为不同上游的理由:
  #   原来主备都是 forward_remote_upstream (8.8.8.8+1.1.1.1 双上游)
  #   always_standby 导致每次查询并行打两轮到同一组服务器，双倍负载零冗余
  #   拆分后 Google 和 Cloudflare 独立故障域，真正的高可用
  # =========================================================================

  - tag: fallback
    type: fallback
    args:
      primary: forward_google_upstream
      secondary: forward_cloudflare_upstream
      threshold: 500
      always_standby: true

  - tag: fallback_seq
    type: sequence
    args:
      - exec: query_summary fallback_remote
      - exec: $fallback

  # =========================================================================
  # 域名分类 → DNS 上游路由规则
  #
  # 命名规则: query_is_<category>_domain
  # 逻辑: 匹配分类规则集 → 调用对应的上游序列 → 否则 return (跳过)
  # =========================================================================

  # Apple 域名 → 国内 DNS 查询 + IP 校验，非国内 IP 则回退 114 DNS
  - tag: query_is_apple_domain
    type: sequence
    args:
      - matches: "!qname $geosite_apple"
        exec: return
      - exec: $apple_domain_fallback

  # DDNS 动态域名 → 强制本地 DNS (保证解析到内网 IP)
  - tag: query_is_ddns_domain
    type: sequence
    args:
      - matches: qname $ddnslist
        exec: $forward_local_seq

  # 非国内域名 (geosite_no_cn) → 远程 DNS
  # 在 geosite_cn 之前匹配，确保同时存在于两个列表的域名走远程 DNS
  - tag: query_is_no_local_domain
    type: sequence
    args:
      - matches: qname $geosite_no_cn
        exec: $forward_remote_seq

  # 国内域名 (geosite_cn) → 国内 DNS 池
  # 仅纯国内域名走到这里（不在 geosite_no_cn 中的 cn 域名）
  - tag: query_is_local_domain
    type: sequence
    args:
      - matches: qname $geosite_cn
        exec: $forward_local_seq

  # 自定义白名单 → 国内 DNS
  - tag: query_is_whitelist_domain
    type: sequence
    args:
      - matches: qname $whitelist
        exec: $forward_local_seq

  # 自定义灰名单 (疑似污染域名) → 安全起见走远程 DNS
  - tag: query_is_greylist_domain
    type: sequence
    args:
      - matches: qname $greylist
        exec: $forward_remote_seq

  # 拒绝类 — 黑名单 或 PTR 反向查询 或 HTTPS 类型
  - tag: query_is_reject_domain
    type: sequence
    args:
      - matches: qname $blocklist
        exec: $reject_blocklist
      - matches: qtype 12
        exec: $reject_ptr
      - matches: qtype 65
        exec: $reject_https

  # 流媒体域名 → 专用 8.8.8.8 线路 (避免 1.1.1.1 可能返回被屏蔽 IP)
  - tag: query_is_stream_media_domain
    type: sequence
    args:
      - matches: qname $stream_media
        exec: $forward_stream_media_seq

  # =========================================================================
  # 主流程入口 (udp_server / tcp_server 都指向这里)
  #
  # 执行顺序 (按优先级从高到低):
  #
  #   Step 1  metrics_collector         — Prometheus 指标采集 (所有查询)
  #   Step 2  黑名单/PTR/HTTPS 拒绝     — 直接 reject (已知恶意/无用，优先杀掉)
  #   Step 3  广告域名 (默认注释)        — 拒绝
  #   Step 4  hosts_seq                 — 本地 hosts 文件匹配 (内存查表)
  #   Step 5  redirect_seq              — redirect 重定向规则
  #   Step 6  lazy_cache                — DNS 缓存查找 (仅排除 DDNS)
  #   Step 7  Apple 域名                — 国内 CDN 优选 + 114 DNS 备用
  #   Step 8  DDNS 域名                 — 强制本地 DNS
  #   Step 9  自定义白名单               — 强制本地 DNS
  #   Step 10 流媒体域名                — 专用 Google DNS
  #   Step 11 灰名单 (防污染)            — 强制远程 DNS
  #   Step 12 非国内域名 (geosite_no_cn) — Google + Cloudflare
  #           在 geosite_cn 之前匹配，确保同时存在于两个列表的域名走远程 DNS
  #   Step 13 国内域名 (geosite_cn)     — 国内 DNS 池
  #           仅纯国内域名走到这里（不在 geosite_no_cn 中的 cn 域名）
  #   Step 14 fallback 兜底             — Google vs Cloudflare 竞速
  #
  #   每步之后 jump has_resp_sequence:
  #     有响应 → TTL 处理 → Cloudflare IP 黑名单 → accept 返回
  #     无响应 → 继续下一步
  # =========================================================================

  - tag: main_sequence
    type: sequence
    args:
      # Step 1 — Prometheus 指标采集 (所有查询)
      - exec: metrics_collector metrics

      # Step 2 — 拒绝类 (直接杀掉，省去后续所有步骤)
      #   黑名单域名、PTR 反向查询、HTTPS/SVCB 类型
      - exec: $query_is_reject_domain
      - exec: jump has_resp_sequence

      # Step 3 — 广告域名拦截（按需启用: 关闭方法是为下面三行加注释）
      - matches: qname $adlist
        exec: $reject_adlist
      - exec: jump has_resp_sequence

      # Step 4 — hosts 本地解析 (内存查表，极快)
      - exec: $hosts_seq
      - exec: jump has_resp_sequence

      # Step 5 — redirect 重定向
      - exec: $redirect_seq
      - exec: jump has_resp_sequence

      # Step 6 — 缓存 (排除 DDNS，DDNS 需要实时解析)
      #   拒绝类已在前置步骤处理，此处无需再排除 blocklist/local_ptr
      - matches: "!qname $ddnslist"
        exec: $lazy_cache
      - matches:
          - "!qname $ddnslist"
          - has_resp
        exec: query_summary cache
      - exec: jump has_resp_sequence

      # Step 7 — Apple 国内 CDN 优选
      - exec: $query_is_apple_domain
      - exec: jump has_resp_sequence

      # Step 8 — DDNS 强制本地
      - exec: $query_is_ddns_domain
      - exec: jump has_resp_sequence

      # Step 9 — 自定义白名单
      - exec: $query_is_whitelist_domain
      - exec: jump has_resp_sequence

      # Step 10 — 流媒体专用线路
      - exec: $query_is_stream_media_domain
      - exec: jump has_resp_sequence

      # Step 11 — 灰名单 (防 DNS 污染)
      - exec: $query_is_greylist_domain
      - exec: jump has_resp_sequence

      # Step 12 — 非国内域名 → 远程 DNS
      # 在 geosite_cn 之前匹配，确保同时存在于两个列表的域名走远程 DNS
      - exec: $query_is_no_local_domain
      - exec: jump has_resp_sequence

      # Step 13 — 国内域名 → 国内 DNS
      # 仅纯国内域名走到这里（不在 geosite_no_cn 中的 cn 域名）
      - exec: $query_is_local_domain
      - exec: jump has_resp_sequence

      # Step 14 — 兜底: Google vs Cloudflare 竞速
      - exec: $fallback_seq
      - exec: jump has_resp_sequence

  # =========================================================================
  # 服务端监听 — DNS 查询入口
  # =========================================================================

  - tag: udp_server
    type: udp_server
    args:
      entry: main_sequence
      listen: ":5335"

  - tag: tcp_server
    type: tcp_server
    args:
      entry: main_sequence
      listen: ":5335"
